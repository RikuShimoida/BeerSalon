{
	"name": "@beersalon/admin",
	"version": "1.0.0",
	"description": "Beer Salon バーオーナー向け管理画面",
	"private": true,
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
		"e2e": "playwright test",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"test:report": "playwright show-report",
		"reset:modules": "rm -rf .next node_modules && pnpm install"
	},
	"dependencies": {
		"@beersalon/shared": "workspace:*",
		"@stripe/stripe-js": "^8.7.0",
		"@supabase/supabase-js": "^2.95.3",
		"bcryptjs": "^3.0.3",
		"jose": "^6.1.3",
		"next": "^16.1.6",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"server-only": "^0.0.1",
		"stripe": "^20.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@playwright/test": "^1.58.2",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^25.2.2",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"dotenv": "^17.4.2",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	}
}
