# Supabase
# SupabaseプロジェクトのURL（例: https://xxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# Supabaseプロジェクトの匿名キー（公開可能なキー）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabaseサービスロールキー（サーバーサイドのみで使用、機密情報）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret
# JWTトークン署名用のシークレットキー（32文字以上のランダムな文字列推奨）
JWT_SECRET=your_jwt_secret_key

# App
# アプリケーションのベースURL
NEXT_PUBLIC_APP_URL=http://localhost:3001
# サーバーサイド専用のベースURL（Stripe Portal戻りURL等で使用）
ADMIN_BASE_URL=http://localhost:3001

# Stripe
# Stripeのシークレットキー（サーバーサイドで使用、機密情報）
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook署名検証用のシークレット
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripeの公開可能キー（クライアントサイドで使用）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
