{
	"name": "beersalon-monorepo",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"test": "turbo run test",
		"dev:web": "pnpm --filter @beersalon/web dev",
		"dev:admin": "pnpm --filter @beersalon/admin dev",
		"e2e:web": "pnpm --filter @beersalon/web e2e",
		"e2e:admin": "pnpm --filter @beersalon/admin e2e",
		"e2e:setup": "bash scripts/e2e-setup.sh",
		"e2e": "pnpm e2e:web && pnpm e2e:admin",
		"seed:dev": "psql \"postgresql://postgres:postgres@127.0.0.1:54422/postgres\" -f supabase/seed.sql"
	},
	"devDependencies": {
		"@prisma/client": "^7.1.0",
		"prisma": "^7.1.0",
		"turbo": "^2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/engines",
			"esbuild",
			"prisma",
			"sharp"
		]
	}
}
