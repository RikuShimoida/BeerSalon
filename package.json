{
	"name": "beersalon-monorepo",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"build": "turbo run build",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"test": "turbo run test",
		"dev:web": "pnpm --filter @beersalon/web dev",
		"dev:admin": "pnpm --filter @beersalon/admin dev"
	},
	"devDependencies": {
		"@prisma/client": "^7.1.0",
		"prisma": "^7.1.0",
		"turbo": "^2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/engines",
			"esbuild",
			"prisma",
			"sharp"
		]
	}
}
